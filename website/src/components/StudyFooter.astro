---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import { courses, mainFiles, slug } from '../../learning-plan.mjs';

const id = Astro.locals.starlightRoute.id;
const match = courses.find(course => mainFiles(course).some(file => slug(file) === id));
const lessons = match ? mainFiles(match) : [];
const index = lessons.findIndex(file => slug(file) === id);
const isLesson = index >= 0;
const url = (file) => '/Personal-Knowledge-Base/' + slug(file) + '/';
const previous = index > 0 ? lessons[index - 1] : null;
const next = index >= 0 && index < lessons.length - 1 ? lessons[index + 1] : null;
---
{isLesson && (
  <section class="study-actions" aria-label="ความคืบหน้าบทเรียน">
    <div>
      <strong>✅ บทที่ {index + 1}/{lessons.length} ในเส้นทางหลัก</strong>
      <p>เมื่ออ่านและฝึกทบทวนจบแล้ว ทำเครื่องหมายเพื่อบันทึกใน Browser นี้</p>
    </div>
    <button type="button" data-study-id={id} aria-pressed="false">ทำเครื่องหมายว่าเรียนจบ</button>
    <nav class="study-next" aria-label="ไปบทถัดไป">
      {previous ? <a href={url(previous)}>← บทก่อนหน้า</a> : <a href={url(match.dir + '/README.md')}>← ภาพรวมวิชา</a>}
      {next ? <a href={url(next)}>บทถัดไป →</a> : <a href={url(match.dir + '/README.md')}>🏁 กลับหน้าแผนเรียน →</a>}
    </nav>
  </section>
)}
<DefaultFooter><slot /></DefaultFooter>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('button[data-study-id]');
  for (const button of buttons) {
    const id = button.dataset.studyId;
    if (!id) continue;
    const key = 'smart-learning:v1:completed:' + id;
    function draw() {
      let done = false;
      try { done = window.localStorage.getItem(key) === '1'; } catch { /* unavailable */ }
      button.setAttribute('aria-pressed', String(done));
      button.textContent = done ? '✓ เรียนจบแล้ว — กดเพื่อยกเลิก' : 'ทำเครื่องหมายว่าเรียนจบ';
    }
    draw();
    button.addEventListener('click', () => {
      try {
        if (localStorage.getItem(key) === '1') localStorage.removeItem(key);
        else localStorage.setItem(key, '1');
      } catch { button.textContent = 'ไม่สามารถบันทึกใน Browser นี้ได้'; return; }
      draw();
    });
  }
</script>
